          </zone>
          <zone h='16829' id='22' param='horz' type-v2='layout-flow' w='99266' x='367' y='5987'>
            <zone h='16829' id='23' name='KPI Studios' show-title='false' w='52639' x='367' y='5987'>
              <layout-cache fixed-size-h='210' fixed-size-w='1139' type-h='fixed' type-w='fixed' />
              <zone-style>
                <format attr='border-color' value='#444444' />
                <format attr='border-style' value='none' />
