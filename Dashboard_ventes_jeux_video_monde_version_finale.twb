            <formatted-text>
              <run bold='true' fontalignment='1' fontcolor='#4e79a7' fontsize='24'>Où se créent les jeux vidéo dans le monde ? </run>
            </formatted-text>
            <zone-style>
              <format attr='border-color' value='#444444' />
              <format attr='border-style' value='none' />
              <format attr='border-width' value='0' />
