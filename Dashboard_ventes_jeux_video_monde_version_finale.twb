    <worksheet name='Clustering Plateformes'>
      <table>
        <view>
          <datasources>
            <datasource caption='v_ventes (jeux_video)' name='federated.0m2472a0hdbk8n101oxwy023oom6' />
          </datasources>
          <datasource-dependencies datasource='federated.0m2472a0hdbk8n101oxwy023oom6'>
            <column caption='Part AmériqueNord' datatype='real' name='[Calculation_0845867014602754]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([ventes_na]) / SUM([ventes_monde])' />
            </column>
            <column caption='Part EU' datatype='real' name='[Calculation_0845867014791171]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([ventes_eu]) / SUM([ventes_monde])' />
            </column>
            <column caption='Part JP' datatype='real' name='[Calculation_0845867014856708]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([ventes_jp]) / SUM([ventes_monde])' />
            </column>
            <column datatype='string' name='[Plateforme (clusters)]' parent-model='[AnalyticModel:{601d7426-72da-439c-b214-375987e0cf91}]' role='dimension' type='nominal'>
              <calculation class='categorical-bin' column='[plateforme]' new-bin='true'>
