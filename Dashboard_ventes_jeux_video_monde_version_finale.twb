          <zone h='80665' id='9' param='horz' type-v2='layout-flow' w='99266' x='367' y='18688'>
            <zone h='80665' id='7' type-v2='layout-basic' w='87747' x='367' y='18688'>
              <zone h='66400' id='5' name='Regression éditerus' w='43871' x='367' y='32953'>
                <zone-style>
                  <format attr='border-color' value='#444444' />
                  <format attr='border-style' value='none' />
                  <format attr='border-width' value='0' />
