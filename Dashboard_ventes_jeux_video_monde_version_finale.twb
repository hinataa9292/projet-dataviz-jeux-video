      <column caption='Part AmériqueNord' datatype='real' name='[Calculation_0845867014602754]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([ventes_na]) / SUM([ventes_monde])' />
      </column>
      <column caption='Part EU' datatype='real' name='[Calculation_0845867014791171]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([ventes_eu]) / SUM([ventes_monde])' />
      </column>
      <column caption='Part JP' datatype='real' name='[Calculation_0845867014856708]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([ventes_jp]) / SUM([ventes_monde])' />
      </column>
      <column caption='Ventes (région)' datatype='real' name='[Calculation_1234543013912578]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Paramètre 1234543013392385]&#13;&#10;WHEN &quot;Monde&quot; THEN [ventes_monde]&#13;&#10;WHEN &quot;Amérique du Nord&quot; THEN [ventes_na]&#13;&#10;WHEN &quot;Europe&quot; THEN [ventes_eu]&#13;&#10;WHEN &quot;Japon&quot; THEN [ventes_jp]&#13;&#10;WHEN &quot;Autres&quot; THEN [ventes_autres]&#13;&#10;END' />
      </column>
      <column caption='Nombre de jeux (région)' datatype='integer' name='[Calculation_1234543017893894]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF [Calculation_1234543013912578] &gt; 0 THEN [nom] END)' />
