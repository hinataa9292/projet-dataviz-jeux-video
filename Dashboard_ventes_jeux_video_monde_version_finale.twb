    <worksheet name='KPI Ventes'>
      <table>
        <view>
          <datasources>
            <datasource caption='v_ventes (jeux_video)' name='federated.0m2472a0hdbk8n101oxwy023oom6' />
            <datasource caption='Paramètres' name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Région' datatype='string' name='[Paramètre 1234543013392385]' param-domain-type='list' role='measure' type='nominal' value='&quot;Monde&quot;'>
              <calculation class='tableau' formula='&quot;Monde&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0m2472a0hdbk8n101oxwy023oom6'>
            <column caption='Ventes (région)' datatype='real' name='[Calculation_1234543013912578]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Paramètre 1234543013392385]&#13;&#10;WHEN &quot;Monde&quot; THEN [ventes_monde]&#13;&#10;WHEN &quot;Amérique du Nord&quot; THEN [ventes_na]&#13;&#10;WHEN &quot;Europe&quot; THEN [ventes_eu]&#13;&#10;WHEN &quot;Japon&quot; THEN [ventes_jp]&#13;&#10;WHEN &quot;Autres&quot; THEN [ventes_autres]&#13;&#10;END' />
            </column>
            <column caption='Nombre de jeux (région)' datatype='integer' name='[Calculation_1234543017893894]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF [Calculation_1234543013912578] &gt; 0 THEN [nom] END)' />
            </column>
            <column caption='Nombre de plateformes' datatype='integer' name='[Calculation_1234543018672135]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF [Calculation_1234543013912578] &gt; 0 THEN [plateforme] END)' />
            </column>
            <column caption='Nombre d&apos;éditeurs' datatype='integer' name='[Calculation_1234543018782728]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF [Calculation_1234543013912578] &gt; 0 THEN [editeur] END)' />
            </column>
            <column caption='Decennie' datatype='integer' name='[decennie]' role='dimension' type='ordinal'>
              <aliases>
                <alias key='%null%' value='Année inconnue' />
              </aliases>
            </column>
            <column caption='Editeur' datatype='string' name='[editeur]' role='dimension' type='nominal' />
            <column caption='Nom' datatype='string' name='[nom]' role='dimension' type='nominal' />
            <column-instance column='[decennie]' derivation='None' name='[none:decennie:ok]' pivot='key' type='ordinal' />
            <column caption='Plateforme' datatype='string' name='[plateforme]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_1234543013912578]' derivation='Sum' name='[sum:Calculation_1234543013912578:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_1234543017893894]' derivation='User' name='[usr:Calculation_1234543017893894:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_1234543018672135]' derivation='User' name='[usr:Calculation_1234543018672135:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_1234543018782728]' derivation='User' name='[usr:Calculation_1234543018782728:qk]' pivot='key' type='quantitative' />
